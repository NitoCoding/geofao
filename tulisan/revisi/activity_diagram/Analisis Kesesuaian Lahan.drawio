<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/26.0.0 Chrome/134.0.6998.88 Electron/34.3.1 Safari/537.36" version="26.0.0">
  <diagram name="Analisis Kesesuaian Lahan" id="analisis-kesesuaian">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== SWIMLANE: User ===== -->
        <mxCell id="u-swimlane" value="User" style="swimlane;startSize=40;horizontal=1;fillColor=#E3F2FD;fontStyle=1;fontSize=14;rounded=1;shadow=0;strokeColor=#90CAF9;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="380" height="640" as="geometry" />
        </mxCell>

        <!-- ===== SWIMLANE: System ===== -->
        <mxCell id="s-swimlane" value="Sistem" style="swimlane;startSize=40;horizontal=1;fillColor=#FFF3E0;fontStyle=1;fontSize=14;rounded=1;shadow=0;strokeColor=#FFB74D;" vertex="1" parent="1">
          <mxGeometry x="420" y="40" width="420" height="640" as="geometry" />
        </mxCell>

        <!-- ===== START NODE (User side) ===== -->
        <mxCell id="start" value="" style="ellipse;fillColor=#4CAF50;strokeColor=#388E3C;gradientDirection=none;" vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="24" height="24" as="geometry" />
        </mxCell>

        <!-- ===== USER ACTIVITIES ===== -->
        <mxCell id="u-login" value="Login ke Sistem" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="115" y="110" width="170" height="36" as="geometry" />
        </mxCell>
        <mxCell id="u-pilih-komoditas" value="Pilih Komoditas" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="115" y="170" width="170" height="36" as="geometry" />
        </mxCell>
        <mxCell id="u-pilih-layer" value="Pilih Layer Spasial" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="115" y="230" width="170" height="36" as="geometry" />
        </mxCell>
        <mxCell id="u-klik-analisis" value="Klik Tombol Analisis" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="115" y="290" width="170" height="36" as="geometry" />
        </mxCell>
        <mxCell id="u-lihat-hasil" value="Lihat Hasil di Peta" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="115" y="480" width="170" height="36" as="geometry" />
        </mxCell>
        <mxCell id="u-input-ahli" value="[Opsional] Input Catatan Ahli" style="rounded=1;fillColor=#E8F5E9;strokeColor=#66BB6A;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="95" y="540" width="210" height="36" as="geometry" />
        </mxCell>

        <!-- ===== END NODE (User side) ===== -->
        <mxCell id="end" value="" style="ellipse;fillColor=#F44336;strokeColor=#D32F2F;" vertex="1" parent="1">
          <mxGeometry x="200" y="610" width="24" height="24" as="geometry" />
        </mxCell>

        <!-- ===== SYSTEM ACTIVITIES ===== -->
        <mxCell id="s-validasi" value="Validasi Input" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="535" y="170" width="170" height="36" as="geometry" />
        </mxCell>

        <!-- ===== DECISION: Valid? ===== -->
        <mxCell id="s-decision-valid" value="Input Valid?" style="diamond;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="567" y="230" width="106" height="60" as="geometry" />
        </mxCell>

        <!-- ===== TIDAK VALID (return to user) ===== -->
        <mxCell id="s-invalid-label" value="Tidak" style="text;fontSize=10;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;resizable=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="535" y="258" width="30" height="20" as="geometry" />
        </mxCell>

        <!-- ===== AMBIL DATA ===== -->
        <mxCell id="s-ambil-karakteristik" value="Ambil Data Karakteristik" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="535" y="320" width="170" height="36" as="geometry" />
        </mxCell>

        <!-- ===== LOOP: Untuk Setiap Fitur ===== -->
        <mxCell id="s-loop-fitur" value="Untuk Setiap Fitur dalam Layer" style="hexagon;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;shadow=0;perimeter=hexagonPerimeter;" vertex="1" parent="1">
          <mxGeometry x="545" y="380" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- ===== HITUNG PER PARAMETER ===== -->
        <mxCell id="s-hitung-param" value="Hitung Kelas Per Parameter" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="535" y="460" width="170" height="36" as="geometry" />
        </mxCell>

        <!-- ===== OVERALL ===== -->
        <mxCell id="s-overall" value="Tentukan Kelas Overall (Minimum)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="525" y="520" width="190" height="36" as="geometry" />
        </mxCell>

        <!-- ===== SIMPAN DB ===== -->
        <mxCell id="s-simpan-db" value="Simpan Hasil ke Database (PostGIS)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="525" y="580" width="190" height="36" as="geometry" />
        </mxCell>

        <!-- ===== ARROWS ===== -->

        <!-- Start → Login -->
        <mxCell id="e-start-login" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="u-login">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Login → Pilih Komoditas -->
        <mxCell id="e-login-komoditas" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u-login" target="u-pilih-komoditas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Pilih Komoditas → Pilih Layer -->
        <mxCell id="e-komoditas-layer" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u-pilih-komoditas" target="u-pilih-layer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Pilih Layer → Klik Analisis -->
        <mxCell id="e-layer-analisis" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u-pilih-layer" target="u-klik-analisis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Klik Analisis → Validasi (cross swimlane) -->
        <mxCell id="e-analisis-validasi" value="Kirim Request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="u-klik-analisis" target="s-validasi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Validasi → Decision -->
        <mxCell id="e-validasi-decision" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-validasi" target="s-decision-valid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision: Tidak → kembali ke Pilih Komoditas -->
        <mxCell id="e-decision-tidak" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#F44336;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;dashed=1;" edge="1" parent="1" source="s-decision-valid" target="u-pilih-komoditas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision: Ya → Ambil Karakteristik -->
        <mxCell id="e-decision-ya" value="Ya" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#4CAF50;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;fontColor=#2E7D32;" edge="1" parent="1" source="s-decision-valid" target="s-ambil-karakteristik">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Ambil Karakteristik → Loop Fitur -->
        <mxCell id="e-karakteristik-loop" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-ambil-karakteristik" target="s-loop-fitur">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Loop Fitur → Hitung Per Parameter -->
        <mxCell id="e-loop-param" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-loop-fitur" target="s-hitung-param">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Hitung Per Parameter → Overall -->
        <mxCell id="e-param-overall" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-hitung-param" target="s-overall">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Overall → Simpan DB -->
        <mxCell id="e-overall-db" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-overall" target="s-simpan-db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Simpan DB → Lihat Hasil (cross swimlane) -->
        <mxCell id="e-db-hasil" value="Tampilkan Hasil" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;" edge="1" parent="1" source="s-simpan-db" target="u-lihat-hasil">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lihat Hasil → Input Ahli -->
        <mxCell id="e-hasil-ahli" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="u-lihat-hasil" target="u-input-ahli">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Input Ahli → End -->
        <mxCell id="e-ahli-end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u-input-ahli" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>