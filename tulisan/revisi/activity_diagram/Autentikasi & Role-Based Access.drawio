<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/26.0.0 Chrome/134.0.6998.88 Electron/34.3.1 Safari/537.36" version="26.0.0">
  <diagram name="Autentikasi &amp; Role-Based Access" id="auth-role">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- SWIMLANE: User -->
        <mxCell id="u-swimlane" value="User" style="swimlane;startSize=40;horizontal=1;fillColor=#E3F2FD;fontStyle=1;fontSize=14;rounded=1;shadow=0;strokeColor=#90CAF9;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="380" height="820" as="geometry" />
        </mxCell>

        <!-- SWIMLANE: System -->
        <mxCell id="s-swimlane" value="Sistem" style="swimlane;startSize=40;horizontal=1;fillColor=#FFF3E0;fontStyle=1;fontSize=14;rounded=1;shadow=0;strokeColor=#FFB74D;" vertex="1" parent="1">
          <mxGeometry x="420" y="40" width="460" height="820" as="geometry" />
        </mxCell>

        <!-- START -->
        <mxCell id="start" value="" style="ellipse;fillColor=#4CAF50;strokeColor=#388E3C;" vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="24" height="24" as="geometry" />
        </mxCell>

        <!-- USER ACTIVITIES -->
        <mxCell id="u-akses-halaman" value="Akses Halaman Web" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="115" y="110" width="170" height="36" as="geometry" />
        </mxCell>

        <!-- DECISION: Login? -->
        <mxCell id="u-decision-login" value="Sudah Login?" style="diamond;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="117" y="170" width="166" height="60" as="geometry" />
        </mxCell>

        <mxCell id="u-login-form" value="Isi Form Login&#x0a;(Username &amp; Password)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="105" y="260" width="190" height="40" as="geometry" />
        </mxCell>

        <mxCell id="u-lihat-halaman" value="Akses Halaman&#x0a;Berdasarkan Menu Yang Tersedia" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="95" y="400" width="210" height="36" as="geometry" />
        </mxCell>

        <!-- END -->
        <mxCell id="end" value="" style="ellipse;fillColor=#F44336;strokeColor=#D32F2F;" vertex="1" parent="1">
          <mxGeometry x="200" y="780" width="24" height="24" as="geometry" />
        </mxCell>

        <!-- SYSTEM ACTIVITIES -->
        <mxCell id="s-cek-login" value="Cek Session&#x0a;(Authenticated?)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="555" y="170" width="170" height="36" as="geometry" />
        </mxCell>

        <!-- DECISION: Authenticated? -->
        <mxCell id="s-decision-auth" value="User&#x0a;Terautentikasi?" style="diamond;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="587" y="230" width="106" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s-validasi-login" value="Validasi Username&#x0a;&amp; Password" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="565" y="260" width="150" height="40" as="geometry" />
        </mxCell>

        <!-- DECISION: Credentials valid? -->
        <mxCell id="s-decision-cred" value="Kredensial&#x0a;Valid?" style="diamond;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="577" y="330" width="106" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s-set-session" value="Set Session&#x0a;(Login User)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="565" y="420" width="150" height="36" as="geometry" />
        </mxCell>

        <!-- GET ROLE & MENU -->
        <mxCell id="s-cek-role" value="Cek User Role&#x0a;(superuser/has_role)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="555" y="480" width="170" height="36" as="geometry" />
        </mxCell>

        <!-- DECISION: Role? -->
