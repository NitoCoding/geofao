          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision Role: Ya (superuser) → Semua menu -->
        <mxCell id="e-role-ya" value="Ya → Semua Menu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#4CAF50;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;fontColor=#2E7D32;" edge="1" parent="1" source="s-decision-role" target="s-loop-menu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision Role: Tidak → Filter per role -->
        <mxCell id="e-role-tidak" value="Tidak → Filter MenuRole" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#F57C00;exitX=0;exitY=0.5;entryX=0.5;entryY=0;dashed=1;fontSize=10;" edge="1" parent="1" source="s-decision-role" target="s-loop-menu">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Loop Menu → Render Menu -->
