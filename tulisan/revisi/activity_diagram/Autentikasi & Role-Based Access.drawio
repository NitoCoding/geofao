          <mxGeometry x="577" y="540" width="106" height="60" as="geometry" />
        </mxCell>

        <!-- LOOP: Periksa Menu Role -->
        <mxCell id="s-loop-menu" value="Loop: Periksa MenuRole&#x0a;untuk Setiap Role User" style="hexagon;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="545" y="630" width="170" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s-render-menu" value="Render Sidebar Menu&#x0a;Sesuai Hak Akses" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="545" y="710" width="170" height="36" as="geometry" />
        </mxCell>

        <!-- ARROWS -->
        <mxCell id="e-start-akses" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="u-akses-halaman">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-akses-decision-user" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u-akses-halaman" target="u-decision-login">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- User decision → System: cek session -->
        <mxCell id="e-decision-cek-session" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="u-decision-login" target="s-cek-login">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- System: Cek Session → Decision Auth -->
        <mxCell id="e-cek-decision-auth" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-cek-login" target="s-decision-auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision Auth: Ya (sudah login) → Cek Role -->
        <mxCell id="e-auth-ya" value="Ya" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#4CAF50;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;fontColor=#2E7D32;" edge="1" parent="1" source="s-decision-auth" target="s-cek-role">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision Auth: Tidak → Login form -->
        <mxCell id="e-auth-tidak" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#F44336;exitX=0;exitY=0.5;entryX=0.5;entryY=0;dashed=1;fontSize=10;" edge="1" parent="1" source="s-decision-auth" target="u-login-form">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Login Form → System: validasi -->
        <mxCell id="e-user-form-system" value="Submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="u-login-form" target="s-validasi-login">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Validasi → Decision Cred -->
        <mxCell id="e-validasi-cred" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-validasi-login" target="s-decision-cred">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision Cred: Tidak → Kembali ke login form -->
        <mxCell id="e-cred-tidak" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#F44336;exitX=0;exitY=0.5;entryX=0.5;entryY=0;dashed=1;fontSize=10;" edge="1" parent="1" source="s-decision-cred" target="u-login-form">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision Cred: Ya → Set Session -->
        <mxCell id="e-cred-ya" value="Ya" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#4CAF50;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;fontColor=#2E7D32;" edge="1" parent="1" source="s-decision-cred" target="s-set-session">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Set Session → Cek Role -->
