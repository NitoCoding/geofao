          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Hapus → Redirect (separate path) -->
        <mxCell id="e-hapus-redirect" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#F44336;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-hapus-db" target="s-redirect">
