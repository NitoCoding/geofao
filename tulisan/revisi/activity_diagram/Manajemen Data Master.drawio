        </mxCell>

        <!-- SYSTEM ACTIVITIES -->
        <mxCell id="s-tampil-daftar" value="Tampilkan Daftar Data&#x0a;(List View)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="170" width="170" height="36" as="geometry" />
