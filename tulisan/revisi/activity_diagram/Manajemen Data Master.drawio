          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision: Hapus → System tampil form konfirmasi -->
        <mxCell id="e-action-hapus" value="Hapus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#F44336;exitX=1;exitY=0.7;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="u-decision-action" target="s-tampil-form">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- System Tampil Form → User Isi Form -->
        <mxCell id="e-form-isi" value="Tampilkan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;" edge="1" parent="1" source="s-tampil-form" target="u-isi-form">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Isi Form → System validasi -->
        <mxCell id="e-isi-validasi" value="Submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="u-isi-form" target="s-decision-valid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Valid: Tidak → Kembali ke form -->
        <mxCell id="e-valid-tidak" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#F44336;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=1;fontSize=10;" edge="1" parent="1" source="s-decision-valid" target="u-isi-form">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Valid: Ya → Simpan DB -->
        <mxCell id="e-valid-ya" value="Ya" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#4CAF50;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;fontColor=#2E7D32;" edge="1" parent="1" source="s-decision-valid" target="s-simpan-db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Simpan DB → Redirect -->
