          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Redirect → User Lihat Daftar -->
        <mxCell id="e-redirect-lihat" value="Redirect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;" edge="1" parent="1" source="s-redirect" target="u-lihat-daftar">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lihat Daftar → End -->
