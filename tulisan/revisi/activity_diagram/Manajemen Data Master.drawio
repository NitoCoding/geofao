        <mxCell id="s-tampil-form" value="Tampilkan Form&#x0a;(Create/Update View)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
