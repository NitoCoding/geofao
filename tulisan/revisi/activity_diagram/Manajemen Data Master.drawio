        <mxCell id="s-redirect" value="Redirect ke Daftar&#x0a;(dengan Notifikasi)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="545" y="490" width="180" height="36" as="geometry" />
        </mxCell>

