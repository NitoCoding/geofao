          <mxGeometry x="545" y="245" width="190" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s-render-actions" value="Render Menu Akses Cepat&#xa;(Control Center, Peta, Layer, Komoditas)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="535" y="310" width="210" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s-query-recent" value="Query 5 Hasil Analisis Terbaru&#xa;(select_related commodity &amp; layer)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="535" y="375" width="210" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s-render-table" value="Render Tabel Hasil Terbaru&#xa;(Komoditas, Layer, Status, Progress, Tanggal)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="535" y="440" width="210" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s-render-info" value="Render Info Bar&#xa;(Analisis Aktif, Layer Tersedia, Review)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="545" y="505" width="190" height="40" as="geometry" />
        </mxCell>

        <!-- ARROWS -->
        <mxCell id="e-start-login" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="u-login">
