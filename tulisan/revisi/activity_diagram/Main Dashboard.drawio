        <mxCell id="u-lihat-dashboard" value="Lihat Halaman Dashboard" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="105" y="170" width="190" height="36" as="geometry" />
        </mxCell>
