          <mxGeometry x="117" y="295" width="166" height="60" as="geometry" />
        </mxCell>

        <mxCell id="u-navigasi" value="Navigasi ke Halaman Tujuan&#xa;(Control Center / Peta / Layer / Komoditas)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="85" y="380" width="230" height="40" as="geometry" />
        </mxCell>

        <mxCell id="u-lihat-recent" value="Lihat Tabel Hasil Analisis Terbaru" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="95" y="445" width="210" height="36" as="geometry" />
        </mxCell>

        <!-- END -->
        <mxCell id="end" value="" style="ellipse;fillColor=#F44336;strokeColor=#D32F2F;" vertex="1" parent="1">
          <mxGeometry x="200" y="680" width="24" height="24" as="geometry" />
        </mxCell>

        <!-- SYSTEM ACTIVITIES -->
