          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Render Info → User lihat dashboard -->
        <mxCell id="e-info-user" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s-render-info" target="u-lihat-dashboard">
