          <mxGeometry x="582" y="335" width="106" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s-simpan-user" value="Simpan User ke Database&#xa;(set_password jika ada)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="545" y="425" width="180" height="36" as="geometry" />
        </mxCell>

        <mxCell id="s-simpan-role" value="Simpan UserRole&#xa;(Hapus role lama, tambah baru)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="545" y="485" width="180" height="36" as="geometry" />
        </mxCell>

        <mxCell id="s-hapus-user" value="Hapus User dari Database" style="rounded=1;fillColor=#FFEBEE;strokeColor=#E53935;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="545" y="425" width="180" height="36" as="geometry" />
        </mxCell>

        <mxCell id="s-redirect" value="Redirect ke Daftar User&#xa;(dengan Notifikasi Sukses)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="545" y="550" width="180" height="36" as="geometry" />
        </mxCell>

        <!-- ARROWS -->
        <mxCell id="e-start-buka" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="u-buka-user">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Buka User → Decision Action -->
        <mxCell id="e-buka-decision" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u-buka-user" target="u-decision-action">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision → System: tampil daftar -->
        <mxCell id="e-decision-list" value="Lihat Daftar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=1;exitY=0.3;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="u-decision-action" target="s-tampil-daftar">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision: Tambah/Edit → System tampil form -->
        <mxCell id="e-decision-form" value="Tambah/Edit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#4CAF50;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;fontColor=#2E7D32;" edge="1" parent="1" source="u-decision-action" target="s-tampil-form">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision: Hapus → System tampil konfirmasi -->
        <mxCell id="e-decision-hapus" value="Hapus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#F44336;exitX=1;exitY=0.7;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="u-decision-action" target="s-tampil-konfirmasi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- System Tampil Form → User Isi Form -->
        <mxCell id="e-form-isi" value="Tampilkan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;" edge="1" parent="1" source="s-tampil-form" target="u-isi-form">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Isi Form → Pilih Role -->
        <mxCell id="e-isi-role" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u-isi-form" target="u-pilih-role">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Pilih Role → System validasi -->
        <mxCell id="e-role-validasi" value="Submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="u-pilih-role" target="s-decision-valid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Valid: Tidak → Kembali ke form -->
        <mxCell id="e-valid-tidak" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#F44336;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=1;fontSize=10;" edge="1" parent="1" source="s-decision-valid" target="u-isi-form">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Valid: Ya → Simpan User -->
        <mxCell id="e-valid-ya" value="Ya" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#4CAF50;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;fontColor=#2E7D32;" edge="1" parent="1" source="s-decision-valid" target="s-simpan-user">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Simpan User → Simpan Role -->
        <mxCell id="e-user-role" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-simpan-user" target="s-simpan-role">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Simpan Role → Redirect -->
        <mxCell id="e-role-redirect" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-simpan-role" target="s-redirect">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Konfirmasi Hapus → System hapus -->
        <mxCell id="e-konfirmasi-hapus" value="Konfirmasi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#F44336;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="u-konfirmasi-hapus" target="s-hapus-user">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Hapus User → Redirect -->
        <mxCell id="e-hapus-redirect" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#F44336;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-hapus-user" target="s-redirect">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Redirect → User lihat daftar -->
        <mxCell id="e-redirect-lihat" value="Redirect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;" edge="1" parent="1" source="s-redirect" target="u-lihat-daftar">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lihat Daftar → End -->
        <mxCell id="e-lihat-end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u-lihat-daftar" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- System Tampil Konfirmasi → User Konfirmasi -->
        <mxCell id="e-sys-konfirmasi" value="Tampilkan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#F44336;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;" edge="1" parent="1" source="s-tampil-konfirmasi" target="u-konfirmasi-hapus">
