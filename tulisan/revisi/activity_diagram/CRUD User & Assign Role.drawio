<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/26.0.0 Chrome/134.0.6998.88 Electron/34.3.1 Safari/537.36" version="26.0.0">
  <diagram name="CRUD User &amp; Assign Role" id="crud-user-role">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- SWIMLANE: Admin -->
        <mxCell id="u-swimlane" value="Admin" style="swimlane;startSize=40;horizontal=1;fillColor=#E3F2FD;fontStyle=1;fontSize=14;rounded=1;shadow=0;strokeColor=#90CAF9;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="380" height="820" as="geometry" />
        </mxCell>

        <!-- SWIMLANE: System -->
        <mxCell id="s-swimlane" value="Sistem" style="swimlane;startSize=40;horizontal=1;fillColor=#FFF3E0;fontStyle=1;fontSize=14;rounded=1;shadow=0;strokeColor=#FFB74D;" vertex="1" parent="1">
          <mxGeometry x="420" y="40" width="460" height="820" as="geometry" />
        </mxCell>

        <!-- START -->
        <mxCell id="start" value="" style="ellipse;fillColor=#4CAF50;strokeColor=#388E3C;" vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="24" height="24" as="geometry" />
        </mxCell>

        <!-- ADMIN ACTIVITIES -->
        <mxCell id="u-buka-user" value="Buka Halaman Manajemen User" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="110" width="200" height="36" as="geometry" />
        </mxCell>

        <!-- DECISION: Aksi -->
        <mxCell id="u-decision-action" value="Pilih Aksi:&#xa;Tambah, Edit,&#xa;atau Hapus?" style="diamond;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;align=center;verticalAlign=middle;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="117" y="170" width="166" height="70" as="geometry" />
        </mxCell>

        <mxCell id="u-isi-form" value="Isi Form User&#xa;(Username, Email, Nama, Password)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="270" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="u-pilih-role" value="Pilih Role IAM&#xa;(Admin / Tenaga Ahli / Guest)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="335" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="u-konfirmasi-hapus" value="Konfirmasi Hapus User" style="rounded=1;fillColor=#FFEBEE;strokeColor=#E53935;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="115" y="270" width="170" height="36" as="geometry" />
        </mxCell>

        <mxCell id="u-lihat-daftar" value="Lihat Daftar User&#xa;yang Telah Diperbarui" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="105" y="740" width="190" height="36" as="geometry" />
        </mxCell>

        <!-- END -->
        <mxCell id="end" value="" style="ellipse;fillColor=#F44336;strokeColor=#D32F2F;" vertex="1" parent="1">
          <mxGeometry x="200" y="800" width="24" height="24" as="geometry" />
        </mxCell>

        <!-- SYSTEM ACTIVITIES -->
        <mxCell id="s-tampil-daftar" value="Tampilkan Daftar User&#xa;(List View + Statistik)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="170" width="170" height="36" as="geometry" />
        </mxCell>

        <mxCell id="s-tampil-form" value="Tampilkan Form User&#xa;(Create/Update View)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="270" width="170" height="36" as="geometry" />
        </mxCell>

        <mxCell id="s-tampil-konfirmasi" value="Tampilkan Halaman&#xa;Konfirmasi Hapus" style="rounded=1;fillColor=#FFEBEE;strokeColor=#E53935;fontSize=11;align=center;verticalAlign=middle;shadow=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="270" width="170" height="36" as="geometry" />
        </mxCell>

        <!-- DECISION: Validasi -->
