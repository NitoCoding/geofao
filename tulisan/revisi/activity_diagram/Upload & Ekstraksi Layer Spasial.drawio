          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Simpan Layer Type → Simpan Fitur -->
        <mxCell id="e-type-fitur" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-simpan-layer-type" target="s-simpan-fitur">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Simpan Fitur → User Notif (cross swimlane) -->
        <mxCell id="e-fitur-notif" value="Notifikasi Sukses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;" edge="1" parent="1" source="s-simpan-fitur" target="u-notif-sukses">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Notif → Lihat Layer -->
        <mxCell id="e-notif-lihat" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u-notif-sukses" target="u-lihat-layer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lihat Layer → End -->
        <mxCell id="e-lihat-end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u-lihat-layer" target="end">
          <mxGeometry relative="1" as="geometry" />
