          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Temp Dir → Ekstrak ZIP -->
        <mxCell id="e-temp-zip" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-temp-dir" target="s-ekstrak-zip">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Ekstrak ZIP → Decision .shp -->
