        <mxCell id="e-login-halaman" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u-login" target="u-buka-halaman">
          <mxGeometry relative="1" as="geometry" />
