        <mxCell id="e-halaman-upload" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u-buka-halaman" target="u-klik-upload">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-upload-decision" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u-klik-upload" target="u-decision-file">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- User decision → System validasi -->
        <mxCell id="e-decision-validasi" value="Submit Form" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;" edge="1" parent="1" source="u-decision-file" target="s-validasi-form">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Validasi → Decision -->
        <mxCell id="e-validasi-decision" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-validasi-form" target="s-decision-valid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision: Tidak Valid → User kembali -->
        <mxCell id="e-decision-tidak-valid" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#F44336;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=1;fontSize=10;" edge="1" parent="1" source="s-decision-valid" target="u-decision-file">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-label-tidak-valid" value="Tidak" style="text;fontSize=10;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;resizable=0;rotatable=0;" vertex="1" parent="1">
          <mxGeometry x="535" y="308" width="30" height="20" as="geometry" />
        </mxCell>

        <!-- Decision: Ya → Buat MasterLayer -->
