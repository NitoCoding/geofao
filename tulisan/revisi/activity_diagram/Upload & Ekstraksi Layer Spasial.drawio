          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision SHP: Tidak → Hapus & return error -->
        <mxCell id="e-shp-tidak" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#F44336;exitX=0;exitY=0.5;entryX=0.5;entryY=1;dashed=1;fontSize=10;" edge="1" parent="1" source="s-decision-shp" target="s-validasi-form">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="555" y="590" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Decision SHP: Ya → Baca GDAL -->
        <mxCell id="e-shp-ya" value="Ya" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#4CAF50;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=10;fontColor=#2E7D32;" edge="1" parent="1" source="s-decision-shp" target="s-baca-gdal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Baca GDAL → Decision geom -->
        <mxCell id="e-gdal-geom" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s-baca-gdal" target="s-decision-geom">
